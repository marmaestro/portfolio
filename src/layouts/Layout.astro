---
import { ClientRouter } from 'astro:transitions';
import { ThemeScript } from 'astro-theme-toggle/components';

import '~/styles/studioCmsUi/colors.css';
import '~/styles/studioCmsUi/resets.css';
import '~/styles/studioCmsUi/radii.css';
import '~/styles/global.css';
import '~/styles/overrides.css';
import '~/styles/fonts/cabinet-grotesk.css';
import '~/styles/fonts/satoshi.css';

import PageHeader from '~/components/PageHeader.astro';
import PageFooter from '~/components/PageFooter.astro';

const siteName : string = 'marmaestro';
const { title, description, lang } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = siteName == title ? siteName : `${siteName} | ${title}`;
---

<!doctype html>
<html
        lang = {lang} >
<head>
	<title set:html = {pageTitle} />

    <meta charset = 'utf-8' />
    <meta name = 'viewport' content = 'width = device-width, initial-scale = 1' />
    <meta name = 'generator' content = {Astro.generator} />
    <meta name = 'description' content = {description} />
    <meta property = 'og:title' content = {title} />
    <meta property = 'og:type' content = 'website' />
    <meta property = 'og:description' content = {description} />
    <meta property = 'og:url' content = {canonicalURL} />
    <meta property = 'og:locale' content = 'en_US' />
    <meta property = 'og:site_name' content = {siteName} />
    <meta name = 'generator' content = {Astro.generator} />
	<meta name='apple-mobile-web-app-title' content='marmaestro' />

	<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" />

	<ClientRouter/>
	<ThemeScript />
	<script is:inline>
		// Some page transitions fail natively (browser `moveBefore` hierarchy
		// errors), which aborts the swap before `astro:after-swap` fires and
		// leaves the theme unapplied. `astro:page-load` fires regardless of
		// swap success, so re-apply the theme there as a safety net.
		document.addEventListener('astro:page-load', () => {
			window.astroThemeToggle?.setTheme(window.astroThemeToggle.getTheme());
		});
	</script>
</head>
<body>
<header class="flex flex-row items-center justify-between gap-8 border-b border-border bg-background px-[clamp(1.5rem,5vw,6rem)] py-6">
    <PageHeader/>
</header>
<main>
    <slot/>
</main>
<footer>
    <PageFooter/>
</footer>
</body>
</html>