---
import Layout from '~/layouts/Layout.js'
import ProjectPreview from '~/components/ProjectPreview.js'

import { Masonry } from 'astro-masonry';
import { getCollection } from 'astro:content';
import { useTranslation } from '~/i18n/utils.ts';
import type { Locale } from '~/i18n/constants.ts';

import '~/styles/collection.css';

const t = useTranslation(Astro.currentLocale as Locale);

const projects = (await getCollection('portfolio')).sort
((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
        sitename = 'marmaestro'
		title = {t.portfolio.title}
		description = {t.portfolio.description}>

	<section class='section'>

		<Masonry sortByHeight={true}
				 class='collection grid portfolio'
				 columnClass='column'
				 breakpointCols =
                     {{
                         default: 2,
                         1100: 2,
                         700: 2,
                         500: 1
                     }}
        >
            {
                projects.map(project =>
                    (
							<ProjectPreview fullWidth
									url = {`/portfolio/${project.id}`}
									title = {project.data.title}
									subtitle = {project.data.subtitle}
									description = {project.data.description}
									image = {project.data.image}
									tags = {project.data.tags}
									pinned = {project.data.pinned}
							/>
                    ))
            }
		</Masonry>
	</section>
</Layout>
