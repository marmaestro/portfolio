---
import MarkdownPostLayout from "~/layouts/MarkdownPostLayout.astro";
import { Divider, Badge, Row } from 'studiocms:ui/components';
import { getCollection, render } from 'astro:content';
import { getProjectUrl } from '~/i18n/utils.ts';

export async function getStaticPaths() {
    const portfolio = await getCollection('portfolio');
    return portfolio.map(project => ({
        params: { id: getProjectUrl(project).replace(/^\//, '') },
        props: { project }
    }));
}

const { project } = Astro.props;
const { Content} = await render(project);
const roles = project.data.roles;

const dateOptions: object = {
    year: "numeric",
    month: "long",
    day: "numeric",
};

const formattedDate = new Date(project.data.date).toLocaleDateString(Astro.currentLocale, dateOptions);
---

<MarkdownPostLayout
		title = {project.data.title}
		description = {project.data.description}
>
	<Row class='justify-between items-baseline'>
		<h1 class='text-[1.75rem] tracking-[-0.15rem]'>{project.data.title}</h1>
        {project.data.source.item != '' ?
				<a class='source' href = {project.data.source.url}><Badge variant='flat' size='md' label={project.data.source.item}/></a>
            : null}
	</Row>
	<h2 class='mt-[-1.5rem] text-[1.5rem] font-medium not-italic tracking-[-0.05rem]'>{project.data.subtitle}</h2>
	<Row id='project-roles'>
        {
            roles.map((role) => (
						<Badge label={role} variant='flat' color='mono' size='md'/>
            ))
        }
	</Row>
	<br><Divider/><br>
	<Content/>
</MarkdownPostLayout>
