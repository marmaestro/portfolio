---
import Layout from '~/layouts/Layout.js'
import PostPreview from '~/components/PostPreview.js';

import { Masonry } from 'astro-masonry';
import { getCollection } from 'astro:content';
import { useTranslation } from '~/i18n/utils.ts';
import type { Locale } from '~/i18n/constants.ts';

import '~/styles/section.css';
import '~/styles/collection.css'

const t = useTranslation(Astro.currentLocale as Locale);

const posts = (await getCollection('blog')).sort
((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
		siteName = 'marmaestro'
		title ={t.blog.title}
		description = {t.blog.description}>

    <section class='section'>
		<h1>{t.blog.title}</h1>
        <h2>{t.blog.titles.top}</h2>

		<Masonry sortByHeight={true}
				 class='collection grid blog'
                 columnClass='column'
                 breakpointCols =
                     {{
                         default: 3,
                         1100: 3,
                         700: 2,
                         500: 1
                     }}
        >
            {
                posts.map(post =>
                    (
                            <PostPreview
									url = {`/blog/${post.id}`}
									title = {post.data.title}
									subtitle = {post.data.subtitle}
									description = {post.data.description}
									image = {post.data.image}
									tags = {post.data.tags}
							/>
                    ))
            }
		</Masonry>
    </section>
</Layout>
