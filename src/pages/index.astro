---
import Layout from "~/layouts/Layout.astro"
import PostPreview from '~/components/PostPreview.astro';

import { getCollection } from "astro:content";
import { useTranslation } from "~/i18n/utils.ts";

import type { Locale } from "~/i18n/constants.ts";

import ContactForm from '~/components/contact.jsx';

import { Badge } from 'studiocms:ui/components/badge';

import '~/styles/section.css';
import '~/styles/collection.css';
import '~/styles/home.css';
import {Masonry} from "astro-masonry";
import ProjectPreview from "~/components/ProjectPreview.astro";

const t = useTranslation(Astro.currentLocale as Locale);

/*const posts = (await getCollection('blog')).sort
    ((a, b) =>
        b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 5);*/
const projects = (await getCollection('portfolio'))
    .filter(project => project.data.pinned).sort
    ((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const intro = t.home.intro.body;
const skills = t.home.skills.list;
---
<!-- MAIN PAGE -->
<Layout
        siteName = "marmaestro"
        title = {t.home.title}
        description = {t.home.description}
>
    <!-- Introduction -->
    <section class="section introduction">
        <h1>{t.home.intro.title}</h1>
        <h2>{t.home.intro.subtitle}</h2>
        <!--<Image src={} alt={t.home.intro.image.alt} loading="eager" />-->
        <div class="about-body">
            {
                intro.map(paragraph => ( <p>{paragraph}</p> ))
            }
        </div>
    </section>

    <!-- Skill set -->
    <section class="section skillset">
        <h2>{t.home.skills.title}</h2>
        <p class="muted">{t.home.skills.body}</p>
        {
            skills.map(skill => ( <Badge label={skill} variant="flat" size="lg" icon:="bi:link" /> ))
        }
    </section>

    <!-- Portfolio preview -->
    <section class="section portfolio-preview">
        <h2>{t.home.portfolio.title}</h2>
        <p>{t.home.portfolio.body}</p>

        <div class="collection-container grid">
            {
                projects.map(project =>
                    (
                            <PostPreview
                                    url = {`/portfolio/${project.id}`}
                                    title = {project.data.title}
                                    subtitle = {project.data.subtitle}
                                    image = {project.data.image}
                                    tags = {project.data.tags}
                            />
                    ))
            }
        </div>
    </section>

    <!-- Contact -->
    <section class="section contact">
		<h2>{t.home.contact.title}</h2>
        <div id="contact-grid">
            <div>
				<p>{t.home.contact.body}</p>
				<p>{t.home.contact.message}</p>
				<!-- TODO: Add socials prompt -->
            </div>
			<ContactForm /> <!--TODO: Add "client:load" on deployment !!-->
        </div>
    </section>

    <!-- Footer -->
    <section class="section footer">
		<!--<Image src={} alt={t.home.contact.image.alt} style="margin: auto"/>-->
    </section>
</Layout>
