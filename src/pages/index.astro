---
import Layout from "~/layouts/Layout.astro"
import ProjectPreview from "~/components/ProjectPreview.astro";

import { getCollection } from "astro:content";
import { useTranslation } from "~/i18n/utils.ts";

import type { Locale } from "~/i18n/constants.ts";

import ContactForm from '~/scripts/contact.jsx';

import { Badge } from 'studiocms:ui/components/badge';

import '~/styles/section.css';
import '~/styles/collection.css';
import '~/styles/home.css';

const t = useTranslation(Astro.currentLocale as Locale);

/*const posts = (await getCollection('blog')).sort
    ((a, b) =>
        b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 5);*/
const projects = (await getCollection('portfolio'))
    .filter(project => project.data.pinned).sort
    ((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const intro = t.home.intro.body;
const skills = t.skills.list;
---
<!-- MAIN PAGE -->
<Layout
        siteName = "marmaestro"
        title = {t.home.title}
        description = {t.home.description}
>
    <!-- Introduction -->
    <section class='section introduction'>
        <h1 id='title'>{t.home.intro.title}</h1>
        <h1 id='subtitle'>{t.home.intro.subtitle}</h1>
        <img src={t.home.intro.image.url} alt={t.home.intro.image.alt} loading="eager" />
        <div class="about-body">
            {
                intro.map(paragraph => ( <p class='muted'>{paragraph}</p> ))
            }
        </div>
    </section>

    <!-- Skill set -->
    <section class='section skillset'>
        <h1>{t.skills.title}</h1>
        <p class='muted'>{t.skills.body}</p>
        <div>
            {
                skills.map(skill => ( <Badge label={skill} variant="flat" size="lg" icon:="bi:link" /> ))
            }
		</div>
    </section>

    <!-- Portfolio preview -->
    <section class='section portfolio-preview'>
        <h1>{t.portfolio.title}</h1>
        <p class='muted'>{t.portfolio.body}</p>

        <div class="collection-container grid">
			<ProjectPreview
					url = {`/portfolio/${projects[0].id}`}
					title = {projects[0].data.title}
					description = {projects[0].data.brief}
					image = {projects[0].data.image}
					tags = {projects[0].data.tags}
			/>
			<ProjectPreview
					url = {`/portfolio/${projects[1].id}`}
					title = {projects[1].data.title}
					description = {projects[1].data.brief}
					image = {projects[1].data.image}
					tags = {projects[1].data.tags}
			/>
        </div>
    </section>

    <!-- Contact -->
    <section class="section contact">
		<h1>{t.contact.title}</h1>
        <div id="contact-grid">
            <div>
				<p class='muted'>{t.contact.body}</p>
				<p class='muted'>{t.contact.message}</p>
				<!-- TODO: Add socials prompt -->
            </div>
			<ContactForm /> <!--TODO: Add "client:load" on deployment !!-->
        </div>
    </section>

    <!-- Footer -->
    <section class="section footer">
		<img src={t.contact.image.url} alt={t.contact.image.alt} style="margin: auto"/>
    </section>
</Layout>
