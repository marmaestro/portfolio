---
import Layout from "~/layouts/Layout.astro"
import PostPreviewGrid from '~/components/PostPreviewGrid.astro';
import PostPreviewList from '~/components/PostPreviewList.astro';

import { getCollection } from "astro:content";
import { useTranslation } from "~/i18n/utils.ts";
import type { Locale } from "~/i18n/constants.ts";

import '~/styles/home.css';
import '~/styles/collection.css';

const t = useTranslation(Astro.currentLocale as Locale);

const posts = (await getCollection('blog')).sort
    ((a, b) =>
        b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 5);
const projects = (await getCollection('portfolio'))
    .filter(project => project.data.pinned).sort
    ((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
        siteName = "marmaestro"
        title = {t.home.title}
        description = {t.home.description}
>
    <section class="home">
        <h1>{t.home.title}</h1>

		<h2>{t.home.previews.portfolio}</h2>
		<div class="collection-container grid">
            {
                projects.map(project =>
                    (
						<PostPreviewGrid
								url = {`/portfolio/${project.id}`}
								title = {project.data.title}
                                subtitle = {project.data.subtitle}
								image = {project.data.image}
                                tags = {project.data.tags}
						/>
                ))
            }
		</div>
	</section>

    <section class="home">
        <h2>{t.home.previews.blog}</h2>
		<div class="collection-container list">
            {
                posts.map(post =>
                    (
						<PostPreviewList
								url = {`/blog/${post.id}`}
								title = {post.data.title}
                                subtitle = {post.data.subtitle}
								description = {post.data.description}
								image = {post.data.image}
                                tags = {post.data.tags}
						/>
                ))
            }
		</div>
    </section>
</Layout>
