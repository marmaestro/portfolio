---
import Layout from '~/layouts/Layout.astro'
import ProjectPreview from '~/components/ProjectPreview.astro';
import Skill from '~/components/Skill.astro';

import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslation } from '~/i18n/utils.ts';
import { WideContactForm } from '~/scripts/wideContact.jsx';
import { VerticalContactForm } from '~/scripts/verticalContact.jsx';

import { Image } from 'astro:assets';

import type { Locale } from "~/i18n/constants.ts";

import '~/styles/section.css';
import '~/styles/collection.css';
import '~/styles/home.css';

const t = useTranslation(Astro.currentLocale as Locale);

const projects = (await getCollection('portfolio'))
    .filter(project => project.data.lang == Astro.currentLocale)
    .filter(project => project.data.pinned)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const intro = t.home.intro.body;
const skills = t.skills.list;

import placeholder from '/src/assets/placeholders/banner.png';
---
<!-- MAIN PAGE -->
<Layout
        siteName = "marmaestro"
        title = {t.home.title}
        description = {t.home.description}
        lang = {Astro.currentLocale as Locale}
>
    <!-- Introduction -->
    <section class='section introduction' id='introduction'>
        <h1 id='title'>{t.home.intro.title}</h1>
        <h1 id='subtitle'>{t.home.intro.subtitle}</h1>
        <Image src={placeholder} alt={t.home.intro.image} loading='eager'/>
        <div class="about-body">
            {
                intro.map(paragraph => ( <p class='muted'>{paragraph}</p> ))
            }
        </div>
    </section>

    <!-- Skill set -->
    <section class='section skillset' id='skills'>
        <h1>{t.skills.title}</h1>
        <p class='muted'>{t.skills.body}</p>
        <div>
            {
                skills.map(skill => ( <Skill label={skill} /> ))
            }
		</div>
    </section>

    <!-- Portfolio preview -->
    <section class='section portfolio-preview' id='portfolio'>
        <h1>{t.portfolio.title}</h1>
        <p class='muted'>{t.portfolio.body}</p>

		<div class="collection-container grid">
			<ProjectPreview
					url = {`/portfolio/${projects[0].id}`}
					title = {projects[0].data.title}
					description = {projects[0].data.description}
					image = {projects[0].data.image}
					tags = {projects[0].data.tags}
			/>
			<ProjectPreview
					url = {`/portfolio/${projects[1].id}`}
					title = {projects[1].data.title}
					description = {projects[1].data.description}
					image = {projects[1].data.image}
					tags = {projects[1].data.tags}
			/>
		</div>
    </section>

    <!-- Contact -->
    <section class="section contact" id='contact'>
		<h1>{t.contact.title}</h1>
        <div id="contact-grid">
            <div>
				<p class='muted'>{t.contact.body}</p>
				<p class='muted'>{t.contact.message}</p>
				<!-- TODO: Add socials prompt -->
            </div>
			<WideContactForm client:load/> <!--TODO: Add "client:load" on deployment !!-->
			<VerticalContactForm client:load/> <!--TODO: Add "client:load" on deployment !!-->
        </div>
		<Image src={placeholder} alt={t.contact.image} loading='lazy' />
    </section>
</Layout>
