---
import ErrorLayout from "~/layouts/ErrorLayout.astro"

import { Icon } from 'astro-icon/components';
import { Center } from 'studiocms:ui/components/center';
import { Button } from 'studiocms:ui/components/button';

import {useTranslation} from "~/i18n/utils.ts";
import type {Locale} from "~/i18n/constants.ts";

const t = useTranslation(Astro.currentLocale as Locale);
---

<ErrorLayout
        siteName = "marmaestro"
        title = {t.errorPage.title}
        description = {t.errorPage.description}
>
    <Center>
        <section class="absolute top-1/2 left-1/2 w-full -translate-x-1/2 -translate-y-1/2">
            <div class="text-[5rem] text-foreground">
                <h1 class="m-0 inline text-[10rem] max-[800px]:text-[8rem]">
                    <b>4</b><Icon name="bi:bug" class="relative top-5 max-[800px]:top-4"/><b>4</b>
                </h1>
            </div>
            <div class="text-center font-medium tracking-[2px]">
                <h2 class="my-[10px]">{t.errorPage.oops}</h2>
                <p>{t.errorPage.text}</p>
            </div>
            <Center>
                <Button as='a' color='primary' variant='flat' href={t.errorPage.button.url}>
                    {t.errorPage.button.text}
                </Button>
			</Center>
        </section>
	</Center>
</ErrorLayout>
