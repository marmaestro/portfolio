---
import Layout from "~/layouts/Layout.astro"
import { Icon } from 'astro-icon/components';

import {useTranslation} from "~/i18n/utils.ts";
import type {Locale} from "~/i18n/constants.ts";

import '~/styles/404.css'

const t = useTranslation(Astro.currentLocale as Locale);
---

<Layout
        siteName = "marmaestro"
        title = {t.error.title}
        description = {t.error.description}
>
    <div id="error">
        <div class="error-number">
            <h1>
                <b>4 </b> <Icon name="bi:bug" id="bug"/> <b> 4</b>
            </h1>
        </div>
        <div class="error-text">
            <h2>{t.error.oops}</h2>
            <p>{t.error.text}</p>
        </div>
    </div>
</Layout>