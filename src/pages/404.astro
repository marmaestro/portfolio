---
import ErrorLayout from "~/layouts/ErrorLayout.astro"

import { Icon } from 'astro-icon/components';
import { Button } from 'studiocms:ui/components/button';

import {useTranslation} from "~/i18n/utils.ts";
import type {Locale} from "~/i18n/constants.ts";

const t = useTranslation(Astro.currentLocale as Locale);
---

<ErrorLayout
        siteName = "marmaestro"
        title = {t.errorPage.title}
        description = {t.errorPage.description}
>
    <section class="w-full text-center">
        <div class="text-foreground">
            <h1 class="m-0 inline-flex items-center justify-center text-[10rem] font-display font-extrabold tracking-tight max-[800px]:text-[8rem]">
                <b>4</b><Icon name="bi:bug" class="inline-block"/><b>4</b>
            </h1>
        </div>
        <div class="text-center">
            <h2 class="my-[10px] h-lg">{t.errorPage.oops}</h2>
            <p class="text-foreground-dimmed">{t.errorPage.text}</p>
        </div>
        <div class="mt-6 flex justify-center">
            <Button as='a' color='primary' variant='flat' href={t.errorPage.button.url}>
                {t.errorPage.button.text}
            </Button>
        </div>
    </section>
</ErrorLayout>
