---
import Layout from '~/layouts/Layout.astro';

import { Image } from 'astro:assets';
import { useTranslation, getLocaleStaticPaths } from '~/i18n/utils.ts';
import type { Locale } from '~/i18n/constants.ts';

import '@fancyapps/ui/dist/fancybox/fancybox.css';

export function getStaticPaths() {
    return getLocaleStaticPaths();
}

const t = useTranslation(Astro.currentLocale as Locale);

const images = import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/gallery/**/**.{jpg,jpeg,png,webp}');
---

<Layout
		title={t.gallery.title}
		description={t.gallery.description}
>
	<section class='justified-gallery' id='photoswipe'>
        {
            Object.entries(images).reverse().map(async ([_path, image], index) => {
                const { default: imageData } = await image();
                return (
						<a
								style={`--width: ${imageData.width}; --height: ${imageData.height};`}
								href={imageData.src}
								target='_blank'
								data-fancybox='gallery'
								aria-label='gallery image'
						>
							<Image
									format='webp'
									src={imageData}
									alt=''
									height={400}
									loading={index < 20 ? 'eager' : 'lazy'}
							/>
						</a>
                );
            })
        }
	</section>
</Layout>

<script>
    import { Fancybox } from '@fancyapps/ui/dist/fancybox/';

    // Astro's view transitions don't always re-execute this script's imports
    // cleanly on navigation (a partial/failed swap can leave a stale Fancybox
    // binding attached to nodes that no longer exist, or double-bind on top
    // of a survived one). Destroying before every (re)bind, on both first
    // load and subsequent swaps, keeps exactly one live binding at all times.
    function bindGallery() {
        Fancybox.destroy();
        Fancybox.bind('[data-fancybox]', {
            theme: 'auto',
            mainStyle: {
                '--f-button-width': '44px',
                '--f-button-height': '44px',
                '--f-button-border-radius': '50%',
                '--f-toolbar-padding': '16px',
            },
            Carousel: {
                Arrows: false,
                Toolbar: {
                    display: {
                        left: [],
                        middle: [],
                        right: ['close'],
                    },
                },
                transition: 'slide',
            },
        });
    }

    bindGallery();
    document.addEventListener('astro:page-load', bindGallery);
</script>
