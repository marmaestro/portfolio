---
import Layout from '~/layouts/Layout.astro'
import ProjectPreview from '~/components/ProjectPreview.astro'

import { Masonry } from 'astro-masonry';
import { getCollection } from 'astro:content';
import { useTranslation, getProjectUrl, getLocaleStaticPaths } from '~/i18n/utils.ts';
import type { Locale } from '~/i18n/constants.ts';

export function getStaticPaths() {
    return getLocaleStaticPaths();
}

const t = useTranslation(Astro.currentLocale as Locale);

const projects = (await getCollection('portfolio'))
    .filter(project => project.data.lang == Astro.currentLocale)
    .sort((a, b) => {
        if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
        return b.data.date.valueOf() - a.data.date.valueOf();
    });
---

<Layout
        sitename = 'marmaestro'
		title = {t.portfolio.title}
		description = {t.portfolio.description}>

	<section class = 'section mt-12'>
		<Masonry sortByHeight = {false}
				 class = 'flex flex-row gap-12 mb-12 max-[750px]:flex-col max-[750px]:!mb-6'
				 columnClass = 'column'
				 breakpointCols =
                     {{
                         default: 3,
                         1100: 2,
                         700: 1,
                         500: 1
                     }}
        >
            {
                projects.map(project =>
                    (
							<ProjectPreview fullWidth padded
									url = {getProjectUrl(project)}
									title = {project.data.title}
									subtitle = {project.data.subtitle}
									description = {project.data.description}
									image = {project.data.image}
									tags = {project.data.tags}
									pinned = {project.data.pinned}
							/>
                    ))
            }
		</Masonry>
	</section>
</Layout>
