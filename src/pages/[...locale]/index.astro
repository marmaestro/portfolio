---
import Layout from '~/layouts/Layout.astro'
import ProjectPreview from '~/components/ProjectPreview.astro';
import Skill from '~/components/patterns/Skill.astro';

import { getCollection } from 'astro:content';
import { useTranslation, getProjectUrl, getLocaleStaticPaths } from '~/i18n/utils.ts';
import { WideContactForm } from '~/scripts/wideContact.jsx';
import { VerticalContactForm } from '~/scripts/verticalContact.jsx';

import { Image } from 'astro:assets';

import type { Locale } from "~/i18n/constants.ts";

import '~/styles/collection.css';
import '~/styles/home.css';

export function getStaticPaths() {
    return getLocaleStaticPaths();
}

const locale = Astro.currentLocale as Locale;
const t = useTranslation(locale);

const projects = (await getCollection('portfolio'))
    .filter(project => project.data.lang == locale)
    .sort((a, b) => {
        if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
        return b.data.date.valueOf() - a.data.date.valueOf();
    })
    .slice(0, 2);

const intro = t.home.intro.body;
const skills = t.skills.list;

import introBanner from '/src/assets/about/skyline.jpg';
import contactBanner from '/src/assets/about/abstract-wall.jpg';
---
<!-- MAIN PAGE -->
<Layout
        siteName = "marmaestro"
        title = {t.home.title}
        description = {t.home.description}
        lang = {locale}
>
    <!-- Introduction -->
    <section class='section introduction' id='introduction'>
        <h1 id='title'>{t.home.intro.title}</h1>
        <h1 id='subtitle'>{t.home.intro.subtitle}</h1>
        <Image src={introBanner} alt={t.home.intro.image} loading='eager'/>
        <div class="about-body">
            {
                intro.map(paragraph => ( <p class='muted'>{paragraph}</p> ))
            }
        </div>
    </section>

    <!-- Skill set -->
    <section class='section skillset' id='skills'>
        <h1>{t.skills.title}</h1>
        <p class='muted'>{t.skills.body}</p>
        <div>
            {
                skills.map(skill => ( <Skill label={skill} /> ))
            }
		</div>
    </section>

    <!-- Portfolio preview -->
    <section class='section portfolio-preview' id='portfolio'>
        <h1>{t.portfolio.title}</h1>
        <p class='muted'>{t.portfolio.body}</p>

		<div class="collection-container grid">
            {
                projects.map(project => (
                    <ProjectPreview
                            url = {getProjectUrl(project)}
                            title = {project.data.title}
                            description = {project.data.description}
                            image = {project.data.image}
                            tags = {project.data.tags}
                    />
                ))
            }
		</div>
    </section>

    <!-- Contact -->
    <section class="section contact" id='contact'>
		<h1>{t.contact.title}</h1>
        <div id="contact-grid">
            <div>
				<p class='muted'>{t.contact.body}</p>
				<p class='muted'>{t.contact.message}</p>
				<!-- TODO: Add socials prompt -->
            </div>
			<WideContactForm locale={locale} />
			<VerticalContactForm locale={locale} />
        </div>
		<Image src={contactBanner} alt={t.contact.image} loading='lazy' />
    </section>
</Layout>
