---
import Layout from '~/layouts/Layout.astro'
import ProjectPreview from '~/components/ProjectPreview.astro';
import Skill from '~/components/patterns/Skill.astro';

import { getCollection } from 'astro:content';
import { useTranslation, getProjectUrl, getLocaleStaticPaths } from '~/i18n/utils.ts';
import { WideContactForm } from '~/scripts/wideContact.jsx';
import { VerticalContactForm } from '~/scripts/verticalContact.jsx';

import { Image } from 'astro:assets';

import type { Locale } from "~/i18n/constants.ts";

export function getStaticPaths() {
    return getLocaleStaticPaths();
}

const locale = Astro.currentLocale as Locale;
const t = useTranslation(locale);

const projects = (await getCollection('portfolio'))
    .filter(project => project.data.lang == locale)
    .sort((a, b) => {
        if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
        return b.data.date.valueOf() - a.data.date.valueOf();
    })
    .slice(0, 2);

const intro = t.home.intro.body;
const skills = t.skills.list;

import introBanner from '/src/assets/about/skyline.jpg';
import contactBanner from '/src/assets/about/abstract-wall.jpg';
---
<!-- MAIN PAGE -->
<Layout
        siteName = "marmaestro"
        title = {t.home.title}
        description = {t.home.description}
        lang = {locale}
>
    <!-- Introduction -->
    <section class='section my-24' id='introduction'>
        <h1 class='mb-0 text-[4rem] font-black'>{t.home.intro.title}</h1>
        <h1 class='mt-0 text-[2.5rem] font-bold'>{t.home.intro.subtitle}</h1>
        <Image src={introBanner} alt={t.home.intro.image} loading='eager' class='h-auto'/>
        <div class="mt-5 grid grid-flow-col grid-cols-2 grid-rows-2 gap-4 max-[700px]:flex max-[700px]:flex-col">
            {
                intro.map(paragraph => ( <p class='muted m-0 w-full'>{paragraph}</p> ))
            }
        </div>
    </section>

    <!-- Skill set -->
    <section class='section my-24' id='skills'>
        <h1 class='text-[2.5rem] font-bold'>{t.skills.title}</h1>
        <p class='muted w-[65%] max-[900px]:w-full'>{t.skills.body}</p>
        <div class='mt-8 grid grid-flow-col grid-cols-4 grid-rows-2 gap-6 max-[900px]:grid-flow-row max-[900px]:grid-cols-3 max-[900px]:grid-rows-3 max-[500px]:grid-cols-2 max-[500px]:grid-rows-4 max-[350px]:grid-cols-1 max-[350px]:grid-rows-8'>
            {
                skills.map(skill => ( <Skill label={skill} /> ))
            }
		</div>
    </section>

    <!-- Portfolio preview -->
    <section class='section mt-24 mb-0' id='portfolio'>
        <h1 class='text-[2.5rem] font-bold'>{t.portfolio.title}</h1>
        <p class='muted w-[65%] max-[900px]:w-full'>{t.portfolio.body}</p>

		<div class="flex flex-row gap-4 mb-12 max-[750px]:flex-col max-[750px]:!mb-6">
            {
                projects.map(project => (
                    <ProjectPreview
                            url = {getProjectUrl(project)}
                            title = {project.data.title}
                            description = {project.data.description}
                            image = {project.data.image}
                            tags = {project.data.tags}
                    />
                ))
            }
		</div>
    </section>

    <!-- Contact -->
    <section class="section my-24" id='contact'>
		<h1 class='text-[2.5rem] font-bold'>{t.contact.title}</h1>
        <div class="grid grid-cols-[1.75fr_2fr] items-start gap-8 max-[1280px]:block">
            <div>
				<p class='muted w-full'>{t.contact.body}</p>
				<p class='muted w-full'>{t.contact.message}</p>
				<!-- TODO: Add socials prompt -->
            </div>
			<WideContactForm locale={locale} />
			<VerticalContactForm locale={locale} />
        </div>
		<Image src={contactBanner} alt={t.contact.image} loading='lazy' class='h-auto w-full mt-10' />
    </section>
</Layout>
