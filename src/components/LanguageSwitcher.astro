---
import { Badge } from 'studiocms:ui/components/badge';

import { locales } from '~/i18n/constants.ts';
import { getRelativeLocaleUrl } from "astro:i18n";
import {useTranslation} from "~/i18n/utils.ts";

const currentLang = Astro.currentLocale;
const currentPath = Astro.url.pathname
    .replace(`/${currentLang}/`, '/')
    .replace(/^\//, '');

const t = useTranslation(Astro.currentLocale as Locale);
---
<span id='language-switcher'>
    { Object.entries(locales).map(([_, lang]) => {
        if (lang === currentLang)
        {
            return null;
        }
        const url = getRelativeLocaleUrl(lang, currentPath);
        const label = t.i18n.switchMessage;
        return (
            <a aria-label=`Switch to ${label} site` role='button' type='a' href={url} >
                <Badge label={label} variant='flat' color='primary'/>
            </a>
        );
    })}
</span>
