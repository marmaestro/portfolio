---
import { type Locale, locales } from '~/i18n/constants.ts';

import { getRelativeLocaleUrl } from "astro:i18n";
import {useTranslation} from "~/i18n/utils.ts";


const currentLang = Astro.currentLocale;
const rawPath = Astro.url.pathname;

const currentPath  = !currentLang ? rawPath : rawPath
    .replace(new RegExp(`^/${currentLang}/?`), '')
    .replace(/^\//, '');

const targetPath = !currentPath.startsWith('portfolio/') ?
    currentPath : 'portfolio';

const t = useTranslation(Astro.currentLocale as Locale);
---
<span class='hidden max-sm:flex max-sm:justify-start max-sm:pt-2'>
    { Object.entries(locales).map(([_, lang]) => {
        if (lang === currentLang)
        {
            return null;
        }
        const url = getRelativeLocaleUrl(lang, targetPath)
            .replace(/\/$/, '') || '/';
        const label = t.i18n.switchMessage;
        return (
            <a aria-label=`Switch to ${label} site`
               role='button' type='a'
               class='text-sm font-bold uppercase tracking-[0.08em]'
               href={url} >
                {label}
            </a>
        );
    })}
</span>
