---
import { Row, Badge } from 'studiocms:ui/components';
import { Card } from 'studiocms:ui/components/card';
import { Icon } from 'astro-icon/components';
import { Image } from "astro:assets";

import type { ImageMetadata } from "astro";

const { fullWidth, padded, title, subtitle, description, url, image, tags, pinned } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/portfolio/**/*.{jpeg,jpg,png,gif}');
if (!images[image]) throw new Error(`"${image}" does not exist in glob: "/src/assets/portfolio/**/*.{jpeg,jpg,png,gif}"`);
---

<Card {fullWidth} class='project' style={padded ? 'margin-bottom: 2.5rem;': null} >
    <div slot='header'>
		<Image src={images[image]()} alt ='' loading='eager' />
    </div>

    <div>
        <h1 aria-label='project title'>{title} <sup aria-label='pinned project indicator'>{pinned ? "⭐" : ""}</sup></h1>
        {subtitle ? <h2 aria-label='project subtitle'>{subtitle}</h2> : null}
        <p class='muted'>{description}</p>
    </div>

    <div slot='footer'>
        <div class='footer'>
            <Row gapSize="md">
                {
                    tags && tags.map((tag: string) => (
                                <Badge label={tag} variant='flat'/>
                    ))
                }
            </Row>
            <a href={url} aria-label='Open project'><Icon name='bi:arrow-right-short' size={24}/></a>
        </div>
    </div>
</Card>
