---
import { Badge } from 'studiocms:ui/components/badge';

import { locales } from '~/i18n/constants.ts';
import { getRelativeLocaleUrl } from "astro:i18n";

const currentLang = Astro.currentLocale;
let currentPath = Astro.url.pathname
    .replace(`/${currentLang}/`, '/')
    .replace(/^\//, '');

if (currentPath.startsWith('portfolio/')) {
    currentPath = 'portfolio';
}
---
<span id='language-picker'>
    { Object.entries(locales).map(([_, lang]) => {
        const url = getRelativeLocaleUrl(lang, currentPath);
        const label = lang.toUpperCase();
        return (
            <a aria-label=`Switch to ${label} site` role='option' aria-selected={ lang == Astro.currentLocale } type='a' href={url} id = {lang == Astro.currentLocale ? 'current-lang' : undefined } >
                <Badge label={label} variant='flat' color='mono'/>
            </a>
        );
    })}
</span>
