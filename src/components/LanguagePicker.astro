---
import { locales, defaultLocale, type Locale } from '~/i18n/constants.ts';
import { getLocalizedUrls } from '~/i18n/utils.ts';

const currentLang = (Astro.currentLocale as Locale) ?? defaultLocale;
const urls = await getLocalizedUrls(Astro.url.pathname, Astro.currentLocale as Locale);
---
<span class='flex flex-row flex-wrap justify-end gap-3 max-sm:hidden'>
    { Object.entries(locales).map(([_, lang]) => {
        const url = urls[lang];
        const label = lang.toUpperCase();
        const isCurrent = lang == currentLang;
        return (
            <a aria-label=`Switch to ${label} site`
               role='option' type='a'
               aria-selected={ isCurrent }
               class:list={[
                   'text-sm font-bold uppercase tracking-[0.08em] no-underline',
                   isCurrent
                       ? 'cursor-default text-foreground'
                       : 'text-foreground-dimmed hover:text-primary-text'
               ]}
               href={url}>
                {label}
            </a>
        );
    })}
</span>
