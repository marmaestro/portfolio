---
import { SocialLinks } from '~/config/site.ts';
import { Footer, Row } from 'studiocms:ui/components';
import { Icon } from 'astro-icon/components';
---

<Footer id="footer"
        links = {{
            'Contact': [
                { label: 'Linkedin', href: 'https://linkedin.com/in/marmaestro' },
                { label: 'Bluesky', href: 'https://bsky.app/profile/marmaestro.dev' },
            ],
            'My works': [
                { label: 'GitHub', href: 'https://github.com/marmaestro' },
                { label: 'itch.io', href: 'https://marmaestro.itch.io/' },
            ],
            /*'More of it': [
                { label: 'Medium', href: 'https://medium.com/@marmaestro' },
                { label: 'Tumblr', href: 'https://filmteapot.tumblr.com/' },
            ],*/
        }}
        copyright = 'MIT License © 2026 - marmaestro'
>

    <div slot='brand' class='mar footer-brand'>
        <span class='studiocms-footer-text'>
            <a href = "mailto:contact@marmaestro.dev?subject=Contact">marmaestro</a>
        </span>
    </div>

    <div slot='socials' class='socials'>
        <Row>
            {
                SocialLinks.map((link) => (
                        <a href={link.url} aria-label={link.name}>
							<Icon name={link.icon}/>
						</a>
                ))
            }
        </Row>
    </div>
</Footer>

<style>
    /* copyright is a plain string prop on studiocms:ui's Footer, rendered as
       text — can't wrap just "marmaestro" in a .mar span like the brand logo
       above, so this applies ss01 to the whole line instead. Harmless: no
       other character in "MIT License © 2026 - marmaestro" uses the
       affected glyph. */
    :global(#footer .copyright-span) {
        font-feature-settings: "ss01" 1;
    }
</style>