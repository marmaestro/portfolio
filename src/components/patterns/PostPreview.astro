---
import { Row, Badge, Card } from 'studiocms:ui/components';
import { Image } from 'astro:assets';

import type { ImageMetadata } from 'astro';

const { title, subtitle, description, image, tags } = Astro.props;
const projectsImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/**/*.{jpeg,jpg,png,gif}');
---

<Card variant='filled' style='margin-bottom: 1.5rem;'>
    <div class='grid-item'>
		<Image src={projectsImages[image]()} alt=''/>
        <img src=`~/assets/projects/${image}` alt=""/>
		<div>
			<h1>{title}</h1>
			<h2>{subtitle}</h2>
			<p>{description}</p>
			<Row gapSize="md">
                {
                    tags && tags.map((tag: string) => (
								<Badge label={tag} variant='flat'/>
                    ))
                }
			</Row>
		</div>
    </div>
</Card>
