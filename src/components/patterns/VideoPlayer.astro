---
import { MuxPlayer } from "@mux/mux-player-astro";

interface Props {
    id: string;
    title: string;
    comment?: string;
}

const { id, title, comment } = Astro.props;
---

<div>
    <MuxPlayer
        playbackId = {id}
        metadata = {{
            video_title: {title},
        }}
        autoplay = "muted"
        theme = "minimal"
        accent-color = "oklch(62.5% 0.22  257.87)"

        style = "aspect-ratio: 16/9"
        class:list="mb-2"
    />
    {comment && (
            <p class="text-center mt-0 text-foreground-muted">
                {comment}
            </p>
    )}
</div>
