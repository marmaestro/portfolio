---
import { Row, Badge } from 'studiocms:ui/components';
import { Card } from 'studiocms:ui/components/card';
import { Icon } from 'astro-icon/components';
import { Image } from "astro:assets";

import type { ImageMetadata } from "astro";

const { fullWidth, padded, title, subtitle, description, url, image, tags, pinned, loading = 'eager' } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/portfolio/**/*.{jpeg,jpg,png,gif}');
if (!images[image]) throw new Error(`"${image}" does not exist in glob: "/src/assets/portfolio/**/*.{jpeg,jpg,png,gif}"`);
---

<Card {fullWidth}
      class:list={[
          'project max-[750px]:mb-6',
          '[&_.sui-card-header]:p-0! [&_.sui-card-header_img]:h-auto [&_.sui-card-header_img]:w-full',
          '[&_.sui-card-header_img]:rounded-t-lg [&_.sui-card-header_img]:object-cover',
          '[&_.sui-card-body]:p-4!',
          padded && 'mb-10',
      ]}
>
    <div slot='header'>
		<Image
				src={images[image]()}
				alt=''
				loading={loading}
				fetchpriority={loading === 'eager' ? 'high' : undefined}
				format='webp'
				widths={[400, 700, 1000]}
				sizes='(min-width: 700px) 50vw, 100vw'
				quality={80}
		/>
    </div>

    <div>
        <h3 class='mt-0 mb-1 text-[1.75rem] font-bold font-sans tracking-tight'>
            {pinned && <span class='mr-1.5 inline-block h-2 w-2 bg-primary align-middle' aria-hidden='true' />}
            {title}
            {pinned && <span class='sr-only'> (pinned project)</span>}
        </h3>
        {subtitle ? <h4 class='m-0 mb-2 text-base font-medium'>{subtitle}</h4> : null}
        <p class='muted mt-0 mb-1'>{description}</p>
    </div>

    <div slot='footer'>
        <div class='flex items-center justify-between'>
            <Row gapSize="md">
                {
                    tags && tags.map((tag: string) => (
                                <Badge label={tag} variant='flat' color='primary' rounding='semi'/>
                    ))
                }
            </Row>
            <a href={url} aria-label='Open project'><Icon name='bi:arrow-right-short' size={24} class='block'/></a>
        </div>
    </div>
</Card>
