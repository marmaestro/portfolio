---
import { Icon } from 'astro-icon/components';

interface Props {
    'aria-label'?: string;
}

const { 'aria-label': ariaLabel = 'Theme toggle button' } = Astro.props;
---

<button type='button' id='theme-toggle' class='theme-toggle h-6! w-6! p-1 text-foreground' aria-label={ariaLabel}>
    <span class='theme-toggle-icon-light'>
        <Icon name='lucide:sun' size={16} />
    </span>
    <span class='theme-toggle-icon-dark'>
        <Icon name='lucide:moon' size={16} />
    </span>
</button>

<script>
    import { handleToggleClick } from 'astro-theme-toggle/client';

    document.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest('#theme-toggle');
        if (button) handleToggleClick(event);
    });
</script>

<style>
    .theme-toggle {
        appearance: none;
        background: none;
        border: none;
        cursor: pointer;
        border-radius: var(--radius-sm);
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .theme-toggle:hover {
        background-color: var(--color-background-step-1);
        color: var(--color-primary-text);
    }

    .theme-toggle-icon-light,
    .theme-toggle-icon-dark {
        display: block;
        width: 100%;
        height: 100%;
    }

    .theme-toggle-icon-light :global(svg),
    .theme-toggle-icon-dark :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
    }

    :global(.dark) .theme-toggle-icon-light {
        display: none;
    }

    .theme-toggle-icon-dark {
        display: none;
    }

    :global(.dark) .theme-toggle-icon-dark {
        display: block;
    }
</style>
