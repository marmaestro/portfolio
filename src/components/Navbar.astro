---
import { Row } from 'studiocms:ui/components';
import { WebsiteLinks } from '~/config/site.ts';
import { Toggle } from 'astro-theme-toggle/components';

import NavbarLink from '~/components/NavbarLink.astro';

import '~/styles/navbar.css'
---

<Row id='navbar'>
    <div id="theme-toggle">
		<Toggle/>
    </div>
	<Row>
        {
            WebsiteLinks.map((link) => (
                    <NavbarLink
                            href = {link.url}
                            target = {link.url.charAt(0) === 'h' ? '_blank' : '_self'}
                            rel = {link.url.charAt(0) === 'h' ? 'noopener noreferrer' : undefined}
                    >
                        {link.name}
                    </NavbarLink>
            ))
        }
    </Row>
</Row>
