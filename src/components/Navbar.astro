<script> // TODO : Remake this script so it works in my style
    function toggleNav() {
        const mobileMenu = document.querySelector('#menu')
        const openBtn = document.querySelector('#nav-open-btn')
        const isOpen = mobileMenu?.classList.contains('mobile-nav-open')

        mobileMenu?.classList.toggle('mobile-nav-open')

        if (openBtn) {
            openBtn.setAttribute('aria-expanded', (!isOpen).toString())
        }

        // Trap focus in mobile menu when open
        if (!isOpen && mobileMenu) {
            const closeBtn = mobileMenu.querySelector('#nav-close-btn')
            if (closeBtn instanceof HTMLElement) {
                closeBtn.focus()
            }
        }
    }

    document
        .querySelector('#nav-open-btn')
        ?.addEventListener('click', toggleNav)
    document
        .querySelector('#nav-close-btn')
        ?.addEventListener('click', toggleNav)

    // Close mobile menu on escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            const mobileMenu = document.querySelector('#menu')
            if (mobileMenu?.classList.contains('mobile-nav-open')) {
                toggleNav()
            }
        }
    })
</script>
