---
import { Row, Badge, Card } from 'studiocms:ui/components';
import { Image } from 'astro:assets';

import type { ImageMetadata } from 'astro';

import '~/styles/collection.css'

const { title, subtitle, description, image, tags } = Astro.props;
const portfolioImages = import.meta.glob<{ default: ImageMetadata }>('/src/img/portfolio/*.{jpeg,jpg,png,gif}');
---

<Card variant='filled' style='margin-bottom: 1.5rem;'>
    <div class='grid-item'>
		<Image src={portfolioImages[image]()} alt=''/>
        <img src=`~/img/portfolio/${image}` alt=""/>
		<div>
			<h1>{title}</h1>
			<h2>{subtitle}</h2>
			<p>{description}</p>
			<Row id="tags-row" gapSize="md">
                {
                    tags && tags.map((tag: string) => (
								<Badge label={tag} variant='flat'/>
                    ))
                }
			</Row>
		</div>
    </div>
</Card>
